# Copy this file to .env and adjust as needed:  cp .env.example .env

# Host port the WordPress site is served on (http://localhost:${WP_PORT})
WP_PORT=8080

# Credentials the WordPress app uses to connect to the database.
WORDPRESS_DB_NAME=easynote
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=change-me

# MySQL reads these on first boot to create the database and app user.
# Keep MYSQL_* in sync with the WORDPRESS_DB_* values above.
MYSQL_DATABASE=easynote
MYSQL_USER=wordpress
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
