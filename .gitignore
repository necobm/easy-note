# =============================================================================
# WordPress project .gitignore
#
# Strategy: version only YOUR code (custom themes/plugins/mu-plugins) plus the
# Docker/config scaffolding. WordPress core, default content, secrets, and
# runtime data are NOT committed — core is provided by the `wordpress` Docker
# image and repopulated into the bind-mount on `docker compose up`.
# =============================================================================

# --- Secrets / local env ----------------------------------------------------
.env
# Generated by the WordPress image entrypoint on first boot (contains DB creds
# and auth salts).
wp-config.php

# --- WordPress core (root files) --------------------------------------------
/index.php
/wp-activate.php
/wp-blog-header.php
/wp-comments-post.php
/wp-config-sample.php
/wp-cron.php
/wp-links-opml.php
/wp-load.php
/wp-login.php
/wp-mail.php
/wp-settings.php
/wp-signup.php
/wp-trackback.php
/xmlrpc.php
/license.txt
/readme.html

# --- WordPress core (directories) -------------------------------------------
/wp-admin/
/wp-includes/

# --- wp-content: ignore everything, then re-include only custom code ---------
wp-content/index.php
wp-content/upgrade/
wp-content/uploads/
wp-content/cache/
wp-content/backup*/
wp-content/blogs.dir/
wp-content/advanced-cache.php
wp-content/object-cache.php
wp-content/db.php

# Default themes shipped with WordPress core
wp-content/themes/twentytwenty*/
wp-content/themes/index.php

# Default / bundled plugins shipped with WordPress core
wp-content/plugins/akismet/
wp-content/plugins/hello.php
wp-content/plugins/index.php

# --- IDE / OS / logs ---------------------------------------------------------
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log
